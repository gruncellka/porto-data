#!/bin/sh
# Conventional Commits. Subject prefer 50, hard max 72.
# A body, when present, follows a blank line. Every body line max 72.
# No trailing period on the subject or a body line.
set -eu
msg_file="${1:?}"
msg=$(grep -v '^#' "$msg_file" || true)
subject=$(printf '%s\n' "$msg" | sed -n '1p')
case "$subject" in
	Merge\ * | Revert\ * | '')
		exit 0
		;;
esac

length() {
	printf '%s' "$1" | wc -m | tr -d ' '
}

subject_len=$(length "$subject")
if [ "$subject_len" -gt 72 ]; then
	echo "commit-msg: subject is ${subject_len} characters (max 72; prefer 50)" >&2
	exit 1
fi
case "$subject" in
	*. )
		echo "commit-msg: subject must not end with a period" >&2
		exit 1
		;;
esac

rest=$(printf '%s\n' "$msg" | tail -n +2)
if ! printf '%s\n' "$rest" | grep -q '[^[:space:]]'; then
	exit 0
fi
first=$(printf '%s\n' "$rest" | sed -n '1p')
if [ -n "$first" ]; then
	echo "commit-msg: put the body after a blank line, wrapped at 72" >&2
	exit 1
fi
body_file=$(mktemp)
trap 'rm -f "$body_file"' EXIT
printf '%s\n' "$rest" | tail -n +2 >"$body_file"
while IFS= read -r line; do
	[ -z "$line" ] && continue
	line_len=$(length "$line")
	if [ "$line_len" -gt 72 ]; then
		echo "commit-msg: body line is ${line_len} characters (max 72)" >&2
		exit 1
	fi
	case "$line" in
		*. )
			echo "commit-msg: body line must not end with a period" >&2
			exit 1
			;;
	esac
done <"$body_file"
