{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/gruncellka/porto-data/refs/heads/main/porto_data/schemas/requires.schema.json",
  "title": "Porto requirement tokens",
  "description": "Declarative domain requirements. Omit the property when a node adds none. Do not write an empty array. Compose by set union at resolve.",
  "definitions": {
    "token": {
      "type": "string",
      "enum": [
        "ADDRESS_SENDER",
        "ADDRESS_RECIPIENT"
      ]
    },
    "requires": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/token"
      }
    }
  }
}
