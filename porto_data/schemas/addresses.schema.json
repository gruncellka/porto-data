{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/gruncellka/porto-data/refs/heads/main/porto_data/schemas/addresses.schema.json",
  "title": "Address forms by jurisdiction",
  "description": "Postal address validity facts per ISO 3166-1 alpha-2 jurisdiction (sparse opt-in). When layouts.jurisdictions[CC] exists, standard must match that layout token; otherwise a local-authority token is allowed (e.g. UKRPOSHTA). Not provider wire encoding.",
  "type": "object",
  "required": [
    "file_type",
    "jurisdictions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "const": "addresses"
    },
    "jurisdictions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Z]{2}$": {
          "$ref": "#/definitions/addressJurisdiction"
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "addressField": {
      "type": "string",
      "enum": [
        "name",
        "street",
        "house_number",
        "post_box",
        "postal_code",
        "city",
        "country_code",
        "region_code"
      ]
    },
    "addressFormKind": {
      "type": "object",
      "required": [
        "kind",
        "required"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "street",
            "post_box"
          ]
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/addressField"
          }
        }
      },
      "additionalProperties": false
    },
    "addressJurisdiction": {
      "type": "object",
      "required": [
        "standard",
        "postal_code",
        "forms"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "minLength": 1,
          "description": "Norm token shared with layouts when present (DIN678, SN010130, NFZ10011) or local authority (e.g. UKRPOSHTA)"
        },
        "postal_code": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "ECMAScript/Python-compatible regex for postal code (full match)"
            }
          },
          "additionalProperties": false
        },
        "forms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/addressFormKind"
          },
          "description": "Street and/or post_box form kinds; AddressResolver picks one (XOR)"
        },
        "max_line_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Max characters per address field when the cited standard defines it (e.g. NF Z10-011: 38)"
        }
      },
      "additionalProperties": false
    }
  }
}
