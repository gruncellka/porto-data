{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/gruncellka/porto-data/refs/heads/main/porto_data/schemas/restrictions.schema.json",
  "title": "Restrictions schema",
  "description": "Durable destination restrictions (file: policy/restrictions.json). Collections legal and routing are objects keyed by ISO 3166-1 alpha-2, then optional regions keyed by ISO 3166-2. No record id. Legal jurisdictions are a map of jurisdictions.json identifiers (EU|CH|UA) to instrument arrays (reference, effective_from, optional effective_to). Legal rows also carry short human-readable reason/description (not political labels). Routing keeps authority/reference/reason/description and must not have jurisdictions. Machine impact (block|warn) is resolved by the SDK, not stored here. Load fails closed if a required field is missing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file_type",
    "unit",
    "disclaimer"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "file_type": {
      "type": "string",
      "const": "restrictions"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "date"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "const": "ISO 3166-1 alpha-2"
        },
        "date": {
          "type": "string",
          "const": "ISO 8601"
        }
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "legal": {
      "$ref": "#/definitions/legalMap"
    },
    "routing": {
      "$ref": "#/definitions/routingMap"
    }
  },
  "definitions": {
    "countryKey": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "regionKey": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "effective_from"
      ],
      "properties": {
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/instrument"
      }
    },
    "jurisdictionMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "EU": {
          "$ref": "#/definitions/instruments"
        },
        "CH": {
          "$ref": "#/definitions/instruments"
        },
        "UA": {
          "$ref": "#/definitions/instruments"
        }
      }
    },
    "geoRegion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partial": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "legalRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdictions",
        "reason",
        "description"
      ],
      "properties": {
        "partial": {
          "type": "boolean",
          "const": true
        },
        "jurisdictions": {
          "$ref": "#/definitions/jurisdictionMap"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legalRegions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/regionKey"
      },
      "additionalProperties": {
        "$ref": "#/definitions/legalRegion"
      }
    },
    "geoRegions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/regionKey"
      },
      "additionalProperties": {
        "$ref": "#/definitions/geoRegion"
      }
    },
    "legalCountryRegional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions"
      ],
      "properties": {
        "regions": {
          "$ref": "#/definitions/legalRegions"
        }
      }
    },
    "legalCountryWide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdictions",
        "reason",
        "description"
      ],
      "properties": {
        "jurisdictions": {
          "$ref": "#/definitions/jurisdictionMap"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legalCountry": {
      "oneOf": [
        {
          "$ref": "#/definitions/legalCountryRegional"
        },
        {
          "$ref": "#/definitions/legalCountryWide"
        }
      ]
    },
    "routingCountry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "reference",
        "reason",
        "description"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "regions": {
          "$ref": "#/definitions/geoRegions"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legalMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/countryKey"
      },
      "additionalProperties": {
        "$ref": "#/definitions/legalCountry"
      }
    },
    "routingMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/countryKey"
      },
      "additionalProperties": {
        "$ref": "#/definitions/routingCountry"
      }
    }
  }
}
